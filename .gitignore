.gradle
**/build/
**/bin/

# Generated per-version build files and metadata
# Handled by generate.py from versions.json + templates/
src/fabric/fabric-*/build.gradle.kts
src/fabric/fabric-*/resources/*
src/forge/forge-*/build.gradle.kts
src/forge/forge-*/resources/*
src/neoforge/neoforge-*/build.gradle.kts
src/neoforge/neoforge-*/resources/*
src/quilt/quilt-*/build.gradle.kts
src/quilt/quilt-*/resources/*

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# Vim
*.swp
*.swo

# Logs
*.log

# Android Studio / IntelliJ local config
local.properties
